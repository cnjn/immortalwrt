CONFIG_TARGET_zte=y
CONFIG_TARGET_zte_zx279133=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_zte_zx279133_DEVICE_zte_zxslc-sr1010-flash=y
CONFIG_TARGET_DEVICE_PACKAGES_zte_zx279133_DEVICE_zte_zxslc-sr1010-flash=""
CONFIG_DEVEL=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_KERNEL_DEVTMPFS=y
CONFIG_KERNEL_DEVTMPFS_MOUNT=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_apk-mbedtls=y
# CONFIG_PACKAGE_apk-openssl is not set
CONFIG_PACKAGE_libmbedtls=y
# CONFIG_PACKAGE_libopenssl is not set
CONFIG_PACKAGE_libustream-mbedtls=y
# CONFIG_PACKAGE_libustream-openssl is not set
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-lib-nixio_notls=y
# CONFIG_PACKAGE_luci-lib-nixio_openssl is not set
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_zte-fwslot=y
# Default address of the LAN, and of the failsafe network before it is up.
CONFIG_IMAGEOPT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_IP="192.168.5.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.5.255"
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y

# Router basics: firewall and NAT with hardware flow offloading, IPv6, PPPoE.
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_kmod-nft-offload=y
# Transparent proxies in nft mode (sing-box, xray, passwall...) need TPROXY and the
# socket match. Policy routing and connection marks are in the kernel already.
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-app-package-manager=y

# VPN.
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y

# dae (the core of daed, configured from a text file in LuCI) needs eBPF: the host
# clang builds the BPF objects and the kernel needs BTF. daed itself carries a
# web UI that doubles its size and does not fit a firmware slot next to tailscale.
CONFIG_PACKAGE_luci-app-dae=y
CONFIG_BPF_TOOLCHAIN_HOST=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_BPF_EVENTS=y

# Web terminal.
CONFIG_PACKAGE_luci-app-ttyd=y

# Theme.
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# Chinese interface: every selected LuCI app gets its zh-cn translation.
CONFIG_LUCI_LANG_zh_Hans=y

# Services in LuCI.
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-wol=y

# USB storage: the xHCI driver is built into the kernel; FAT and exFAT are
# modules built with it, ext4 for disks formatted on the router itself.
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_smartmontools=y

# Network tools.
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_mtr-nojson=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_nload=y
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_openssh-client=y
CONFIG_PACKAGE_rsync=y

# System tools.
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_less=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_file=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_jq=y

# System > Firmware Slots: start the other firmware, for example the vendor one.
CONFIG_PACKAGE_luci-app-zte-fwslot=y

# Reset button (gpio-keys node of the device tree): /etc/rc.button/reset reboots
# on a short press and restores the factory settings after five seconds.
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y

# Larger squashfs blocks compress the big Go binaries better (about 3 % less).
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024
