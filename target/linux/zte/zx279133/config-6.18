CONFIG_DEBUG_FS=y
# CONFIG_SLUB_DEBUG is not set
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=1
CONFIG_RCU_CPU_STALL_TIMEOUT=60
# CONFIG_RCU_TRACE is not set
# CONFIG_FTRACE is not set
CONFIG_ATOMIC64_SELFTEST=y
# The vendor bootloader passes vendor root= arguments; the rootfs comes from
# the zx279133-rootfs MTD device registered after the seven fixed partitions.
CONFIG_CMDLINE="console=ttyAMA0,115200n8 root=/dev/mtdblock7 rootfstype=squashfs ro rootwait"
CONFIG_CMDLINE_FORCE=y

# The generic OpenWrt baseline switches these upper-level options off, which drops
# the options below them that the board needs: the tags partition (MAC addresses),
# the PVT sensor and its eFuse, and the built-in xHCI controller.
CONFIG_NVMEM=y
CONFIG_NVMEM_LAYOUTS=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_WATCHDOG_SYSFS=y
