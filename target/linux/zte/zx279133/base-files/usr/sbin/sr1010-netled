#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Body light of the ZTE SR1010: white while the WAN has working internet, red
# otherwise. This is the status light. The socket lights beside the ports are a
# different thing: each follows the link of its own port (see board.d/01_leds).
#
# Online means a WAN interface is up and one of the hosts answers a ping sent
# out through it. It takes several failures in a row to go offline, so one lost
# packet does not flip the light. Settings: /etc/config/sr1010-netled.

LEDS=${SR1010_LED_ROOT:-/sys/class/leds}
WHITE=$LEDS/sr1010:white
RED=$LEDS/sr1010:red

get() { uci -q get "sr1010-netled.main.$1" || echo "$2"; }

# Only the light matching the state is on.
show() {
	if [ "$1" = online ]; then
		echo 1 > "$WHITE/brightness"
		echo 0 > "$RED/brightness"
	else
		echo 1 > "$RED/brightness"
		echo 0 > "$WHITE/brightness"
	fi
}

# True when a WAN interface is up and a host answers through it.
online_now() {
	local name status dev host

	for name in $IFACES; do
		status=$(ubus call "network.interface.$name" status 2>/dev/null) || continue
		[ "$(jsonfilter -s "$status" -e '@.up' 2>/dev/null)" = true ] || continue
		dev=$(jsonfilter -s "$status" -e '@.l3_device' 2>/dev/null)
		[ -n "$dev" ] || continue

		for host in $HOSTS; do
			ping -q -c 1 -W 2 -I "$dev" "$host" >/dev/null 2>&1 && return 0
		done
	done

	return 1
}

INTERVAL=$(get interval 5)
UP_COUNT=$(get up_count 1)
DOWN_COUNT=$(get down_count 3)
IFACES=$(get iface wan)
HOSTS=$(get host "223.5.5.5 119.29.29.29 1.1.1.1")
LOOPS=${SR1010_NETLED_LOOPS:-0}	# 0 = run until stopped; set for testing

# Take the lights over from any trigger and start from "offline".
for led in "$WHITE" "$RED"; do
	echo none > "$led/trigger" 2>/dev/null
done

state=offline
ok=0
bad=0
n=0
show offline

while :; do
	if online_now; then
		ok=$((ok + 1))
		bad=0
	else
		bad=$((bad + 1))
		ok=0
	fi

	if [ "$state" = offline ] && [ "$ok" -ge "$UP_COUNT" ]; then
		state=online
		show online
		logger -t sr1010-netled "WAN is online"
	elif [ "$state" = online ] && [ "$bad" -ge "$DOWN_COUNT" ]; then
		state=offline
		show offline
		logger -t sr1010-netled "WAN is offline"
	fi

	[ -n "$SR1010_NETLED_TRACE" ] && echo "state=$state ok=$ok bad=$bad" >&2

	n=$((n + 1))
	[ "$LOOPS" -gt 0 ] && [ "$n" -ge "$LOOPS" ] && break
	sleep "$INTERVAL"
done
