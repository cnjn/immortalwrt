#!/bin/sh
# Fresh installs use Design. Migrate the previous board-default Bootstrap once,
# while preserving another theme selected by the user across upgrades.
marker="$(uci -q get luci.main.zx279133_theme)"
[ "$marker" = design-v1 ] && exit 0
uci -q get luci.themes.Design >/dev/null || exit 0
current="$(uci -q get luci.main.mediaurlbase)"
if [ -z "$marker" ] || { [ "$marker" = 1 ] && [ "$current" = /luci-static/bootstrap ]; }; then
	uci -q set luci.main.mediaurlbase=/luci-static/design
fi
uci -q set luci.main.zx279133_theme=design-v1
uci -q commit luci
exit 0
