-	if (replace)
-		cursor += 8;
-	else if (!strncmp(buf, "set ", 4))
-		cursor += 4;
-	else
-		return -EINVAL;
-	while ((line = strsep(&cursor, "\n"))) {
-		if (!*line)
-			continue;
-		if (n == ARRAY_SIZE(rows) || (!replace && n) ||
-		    sscanf(line, "%17s %10s %c", mac, number, &extra) != 2 ||
-		    kstrtou32(number, 10, &limit) ||
-		    strlen(mac) != 17 || !mac_pton(mac, rows[n].mac) ||
-		    !is_valid_ether_addr(rows[n].mac) || limit > 65535)
-			return -EINVAL;
-		for (i = 0; i < n; i++)
-			if (ether_addr_equal(rows[i].mac, rows[n].mac))
-				return -EINVAL;
-		rows[n++].limit = limit;
-	}
-	if (!replace && !n)
-		return -EINVAL;
-	spin_lock_bh(&table->lock);
-	/* Allocate all required MAC records before changing any existing policy. */
-	for (i = 0; i < n; i++) {
-		rows[i].client = nf_flow_client_get(table, rows[i].mac);
-		if (!rows[i].client) {
-			ret = -ENOMEM;
-			goto out;
-		}
