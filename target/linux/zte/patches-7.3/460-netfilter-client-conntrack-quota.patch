-	if (replace)
-		list_for_each_entry(c, &table->records, list)
-			if (!c->parent)
-				WRITE_ONCE(c->hw_limit, 0);
-	for (i = 0; i < n; i++)
-		WRITE_ONCE(rows[i].client->hw_limit, rows[i].limit);
-out:
-	spin_unlock_bh(&table->lock);
-	return ret;
-}
