-/* One slot per logical connection, even when both directions/endpoints match.
- * Reservations prevent concurrent ADD workers from oversubscribing a limit.
- * Existing slots survive policy changes and client deactivation until actual
- * hardware removal (or final flow free) has completed.
- */
-static int nf_flow_clients_reserve_locked(struct flow_offload *flow)
-{
-	struct nf_flow_client *c;
-	int d;
-
-	if (flow->client_hw_slot)
-		return 0;
-	for (d = 0; d < FLOW_OFFLOAD_DIR_MAX; d++) {
-		c = flow->client[d];
-		if (!c || (d && c == flow->client[0]))
-			continue;
-		if (c->hw_limit && c->hw_slots >= c->hw_limit)
-			return -EDQUOT;
-	}
-	for (d = 0; d < FLOW_OFFLOAD_DIR_MAX; d++) {
-		c = flow->client[d];
-		if (c && (!d || c != flow->client[0]))
-			c->hw_slots++;
-	}
-	flow->client_hw_slot = true;
-	return 0;
-}
-
-static void nf_flow_clients_slot_put_locked(struct flow_offload *flow)
-{
-	struct nf_flow_client *c;
-	int d;
-
-	if (!flow->client_hw_slot)
-		return;
-	for (d = 0; d < FLOW_OFFLOAD_DIR_MAX; d++) {
-		c = flow->client[d];
-		if (c && (!d || c != flow->client[0])) {
-			if (WARN_ON_ONCE(!c->hw_slots))
-				continue;
-			c->hw_slots--;
-		}
-	}
-	flow->client_hw_slot = false;
-}
-
-/* A failed/uncertain MMIO delete must not create a reusable quota slot. */
-static bool nf_flow_clients_slot_safe(struct flow_offload *flow)
-{
-	int d, error;
-
-	for (d = 0; d < FLOW_OFFLOAD_DIR_MAX; d++) {
-		if (flow->hw[d].state == NF_FLOW_HW_QUARANTINED)
-			return false;
-		error = flow->hw[d].error;
-		if (error && error != -EAGAIN && error != -ENOSPC &&
-		    error != -ENOMEM && error != -EOPNOTSUPP && error != -EEXIST &&
-		    error != -ENETDOWN && error != -ENOENT && error != -EDQUOT)
-			return false;
-	}
-	return true;
-}
-
-int nf_flow_clients_reserve(struct flow_offload *flow)
-{
-	struct nf_flow_clients *table = nf_ct_net(flow->ct)->ft.clients;
-	int ret;
-
-	if (READ_ONCE(flow->client_hw_slot))
-		return 0;
-	spin_lock_bh(&table->lock);
-	spin_lock_bh(&flow->hw_lock);
-	ret = flow->client_active ? nf_flow_clients_reserve_locked(flow) : -ENOENT;
-	spin_unlock_bh(&flow->hw_lock);
-	spin_unlock_bh(&table->lock);
-	return ret;
-}
