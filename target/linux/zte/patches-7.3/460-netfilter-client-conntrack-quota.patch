Subject: [PATCH] netfilter: enforce SR1010 client quotas at conntrack admission

--- a/net/netfilter/Kconfig
+++ b/net/netfilter/Kconfig
@@ -144,6 +144,13 @@
 	  contained in different zones.
 
 	  If unsure, say `N'.
+
+config NF_CONNTRACK_CLIENT_QUOTA
+	bool "Connection quotas for configured client addresses"
+	depends on NF_CONNTRACK && PROC_FS
+	help
+	  Count and cap confirmed connections for a configured group of client
+	  IPv4 and IPv6 addresses, independent of flow offload.
 
 config NF_CONNTRACK_PROCFS
 	bool "Supply CT list in procfs (OBSOLETE)"
