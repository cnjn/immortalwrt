'use strict';

import { access, readfile, writefile, stat, popen, chmod, open, mkdir, rmdir, glob } from 'fs';
import { cursor } from 'uci';
import { connect } from 'ubus';

const UCI_CONFIG = 'flowproxy';
const STATE_FILE = '/var/run/flowproxy.running';
const IP_CACHE = '/tmp/flowproxy/lan_ip.cache';
const LOG_FILE = '/var/log/flowproxy.log';
const NFT_TABLE = 'flowproxy';

// 辅助函数：安全 trim
function safe_trim(str) {
    return (type(str) === 'string') ? trim(str) : '';
}

function import_workspace(ticket) {
    return type(ticket) == 'string' && match(ticket, /^flowproxy-import\.[A-Za-z0-9]+$/) ? '/tmp/' + ticket : null;
}
function new_import_workspace() {
    let tmp = popen('umask 077; mktemp -d /tmp/flowproxy-import.XXXXXX');
    let dir = tmp ? trim(tmp.read('all') || '') : ''; if (tmp) tmp.close();
    return match(dir, /^\/tmp\/flowproxy-import\.[A-Za-z0-9]+$/) ? dir : null;
}
function queue_import(dir) {
    if (system('/usr/share/flowproxy/import-worker.sh ' + dir + ' >/dev/null 2>&1 </dev/null &') != 0)
        return { result: false, error: 'Unable to start configuration import' };
    return { result: true, ticket: substr(dir, 5) };
}
function with_upload(ticket, callback) {
    let dir = import_workspace(ticket);
    if (!dir || !mkdir(dir + '/upload.lock')) return { result: false, error: 'Invalid, expired or busy upload' };
    let result;
    try {
        let meta = json(readfile(dir + '/upload.json') || '{}');
        if (meta.phase != 'uploading' || meta.expires < time()) die('Invalid or expired upload');
        result = callback(dir, meta);
    } catch (e) { result = { result: false, error: '' + e }; }
    rmdir(dir + '/upload.lock');
    return result;
}

function service_ip_status(vendor, uci_cursor) {
    let base = '/etc/flowproxy/service-ips/' + vendor;
    let cached = access(base + '.cidr', 'r');
    let path = cached ? base + '.cidr' : '/usr/share/flowproxy/service-ips/' + vendor + '.cidr';
    let count = 0;
    for (let line in split(readfile(path) || '', '\n')) if (trim(line)) count++;
    let details = {};
    try { details = json(readfile(base + '.json') || '{}'); } catch(e) {}
    return {
        enabled: int(uci_cursor.get(UCI_CONFIG, 'global', vendor + '_ip_direct_enabled') || '0'),
        count: count, cached: cached ? 1 : 0,
        last_success: details.last_success || 0,
        result: details.result || 'bundled'
    };
}

const methods = {
    begin_import: {
        call: function() {
            let active = 0;
            for (let dir in (glob('/tmp/flowproxy-import.*') || [])) {
                if (!match(dir, /^\/tmp\/flowproxy-import\.[A-Za-z0-9]+$/)) continue;
                let meta = {};
                try { meta = json(readfile(dir + '/upload.json') || '{}'); } catch (e) {}
                if (meta.phase != 'uploading') continue;
                if (meta.expires < time()) system('rm -rf ' + dir);
                else active++;
            }
            if (active >= 3) return { result: false, error: 'Too many unfinished uploads; retry in ten minutes' };
            let dir = new_import_workspace();
            if (!dir) return { result: false, error: 'Unable to create import workspace' };
            if (writefile(dir + '/input.json', '') == null || !chmod(dir + '/input.json', 0o600) ||
                writefile(dir + '/upload.json', sprintf('%J', { phase: 'uploading', next: 0, size: 0, expires: time() + 600 })) == null) {
                system('rm -rf ' + dir);
                return { result: false, error: 'Unable to stage configuration backup' };
            }
            return { result: true, ticket: substr(dir, 5) };
        }
    },
    upload_import_chunk: {
        args: { ticket: '', index: 0, data: '' },
        call: function(request) {
            let args = request.args || {};
            return with_upload(args.ticket, function(dir, meta) {
                if (type(args.data) != 'string' || !length(args.data) || length(args.data) > 32768 ||
                    args.index != meta.next || meta.size + length(args.data) > 1048576)
                    die('Invalid, oversized or out-of-order configuration chunk');
                let fd = open(dir + '/input.json', 'a', 0o600);
                if (!fd) die('Unable to open configuration upload');
                let count = fd.write(args.data); fd.close();
                if (count != length(args.data)) die('Unable to write configuration chunk');
                meta.next++; meta.size += count; meta.expires = time() + 600;
                if (writefile(dir + '/upload.json', sprintf('%J', meta)) == null) die('Unable to update upload progress');
                return { result: true };
            });
        }
    },
    finish_import: {
        args: { ticket: '', size: 0 },
        call: function(request) {
            let args = request.args || {};
            return with_upload(args.ticket, function(dir, meta) {
                let info = stat(dir + '/input.json');
                if (!info || !meta.size || meta.size != args.size || info.size != meta.size)
                    die('Incomplete configuration upload');
                meta.phase = 'running';
                if (writefile(dir + '/upload.json', sprintf('%J', meta)) == null) die('Unable to finish upload');
                return queue_import(dir);
            });
        }
    },
    export_config: {
        call: function() {
            let fd = popen('/usr/bin/ucode /usr/share/flowproxy/config-transfer.uc export');
            if (!fd) return { result: false, error: 'Unable to start configuration export' };
            let output = fd.read('all'); fd.close();
            try { return json(output); }
            catch (e) { return { result: false, error: 'Unable to export saved configuration' }; }
        }
    },
    import_config: {
        args: { data: '' },
        call: function(request) {
            let data = request.args?.data;
            if (type(data) != 'string' || !length(data) || length(data) > 1048576)
                return { result: false, error: 'Backup is empty or exceeds the 1 MiB limit' };
            let dir = new_import_workspace();
            if (!dir)
                return { result: false, error: 'Unable to create import workspace' };
            try {
                if (writefile(dir + '/input.json', data) == null || !chmod(dir + '/input.json', 0o600))
                    die('Unable to stage configuration backup');
                return queue_import(dir);
            } catch (e) {
                system('rm -rf ' + dir);
                return { result: false, error: '' + e };
            }
        }
    },
    get_import_status: {
        args: { ticket: '' },
        call: function(request) {
            let ticket = request.args?.ticket || '';
            if (!match(ticket, /^flowproxy-import\.[A-Za-z0-9]+$/))
                return { result: false, error: 'Invalid import ticket' };
            let content = readfile('/tmp/flowproxy/import-results/' + ticket + '.json');
            if (content) {
                try { return json(content); }
                catch (e) { return { result: false, error: 'Invalid import result' }; }
            }
            return access('/tmp/' + ticket) ? { pending: true } : { result: false, error: 'Import task is no longer available' };
        }
    },
    get_status: {
        call: function() {
            // 1. 快速探测
            let is_running = access(STATE_FILE, 'f');
            
            // 2. 自愈：检查内核状态并同步标记文件
            let tcp_active = (system('nft list chain inet ' + NFT_TABLE + ' LAN_MARKFLOW_TCP >/dev/null 2>&1') === 0);
            let udp_active = (system('nft list chain inet ' + NFT_TABLE + ' LAN_MARKFLOW_UDP >/dev/null 2>&1') === 0);
            let real_running = (tcp_active || udp_active);

            if (real_running && !is_running) {
                try { writefile(STATE_FILE, ''); } catch(e) {}
            } else if (!real_running && is_running) {
                try { system('rm -f ' + STATE_FILE); } catch(e) {}
            }

            // 3. IP 获取 (带缓存)
            let lan_ip = readfile(IP_CACHE) || '';
            if (!lan_ip) {
                try {
                    let ubus_conn = connect();
                    if (ubus_conn) {
                        let ifaces = ubus_conn.call('network.interface', 'dump');
                        if (type(ifaces?.interface) === 'array') {
                            // 优先寻找名为 'lan' 的接口，或者寻找拥有 ipv4 地址的第一个非回环接口
                            let fallback_ip = '';
                            for (let iface in ifaces.interface) {
                                if (iface.interface === 'lan' && iface['ipv4-address']?.[0]?.address) {
                                    lan_ip = iface['ipv4-address'][0].address;
                                    break;
                                }
                                if (!fallback_ip && iface.interface !== 'loopback' && iface['ipv4-address']?.[0]?.address) {
                                    fallback_ip = iface['ipv4-address'][0].address;
                                }
                            }
                            if (!lan_ip) lan_ip = fallback_ip;
                        }
                        
                        if (lan_ip) {
                            system('mkdir -p /tmp/flowproxy');
                            writefile(IP_CACHE, lan_ip);
                        }
                        ubus_conn.disconnect();
                    }
                } catch (e) {}
            }

            let uci_cursor = cursor();
            let health = {};
            try { health = json(readfile('/tmp/flowproxy/health.json') || '{}'); } catch (e) {}

            let proxy_server_ip_addr = uci_cursor.get(UCI_CONFIG, 'global', 'proxy_server_ip_addr') || '';
            let dns_running = (uci_cursor.get(UCI_CONFIG, 'dns_backup') ? 1 : 0);
            
            let domain_cached_ips = 0;
            try {
                let fd = popen('nft -j list set inet flowproxy fp_direct_domains 2>/dev/null');
                if (fd) {
                    let data = fd.read('all'); fd.close();
                    if (data) for (let item in (json(data)?.nftables || []))
                        if (item.set?.elem) domain_cached_ips = length(item.set.elem);
                }
            } catch(e) {}
            return {
                health: health,
                service_ips: {
                    apple: service_ip_status('apple', uci_cursor),
                    microsoft: service_ip_status('microsoft', uci_cursor)
                },
                domain_dns_running: access('/tmp/flowproxy/dns.ready', 'f') ? 1 : 0,
                domain_cached_ips: domain_cached_ips,
                running: real_running ? 1 : 0,
                dns_running: dns_running,
                enabled: int(uci_cursor.get(UCI_CONFIG, 'global', 'enabled') || '0'),
                proxy_server_ip_addr: proxy_server_ip_addr,
                proxy_server_dns_port: uci_cursor.get(UCI_CONFIG, 'global', 'proxy_server_dns_port') || '5353',
                lan_ip: safe_trim(lan_ip),
                interface: uci_cursor.get(UCI_CONFIG, 'global', 'interface') || 'br-lan',
                traffic_mark: uci_cursor.get(UCI_CONFIG, 'global', 'traffic_mark') || '0x666',
                nft: { tcp: tcp_active ? 1 : 0, udp: udp_active ? 1 : 0 }
            };
        }
    },

    update_service_ips: {
        call: function() {
            return { result: system('/usr/share/flowproxy/update_service_ips.sh --once >/tmp/flowproxy-service-ip-update.log 2>&1 </dev/null &') === 0 };
        }
    },

    get_logs: {
        args: { lines: 100 },
        call: function(request) {
            let lines = request.args?.lines ?? 100;
            let logs = [];
            try {
                if (access(LOG_FILE, 'r')) {
                    let log_stat = stat(LOG_FILE);
                    let content = '';
                    if (log_stat && log_stat.size > 65536) {
                        let fd = popen('tail -c 65536 ' + LOG_FILE);
                        if (fd) {
                            content = fd.read('all');
                            fd.close();
                        }
                    } else {
                        content = readfile(LOG_FILE);
                    }
                    if (content) {
                        let log_lines = split(content, "\n");
                        let total = length(log_lines);
                        let start = (total > lines) ? (total - lines) : 0;
                        for (let i = start; i < total; i++) {
                            if (log_lines[i]) push(logs, log_lines[i]);
                        }
                    }
                }
            } catch (e) {}
            return { logs };
        }
    },

    generate_nft_config: {
        call: function() {
            system('mkdir -p /tmp/flowproxy');
            let fd = popen('FLOWPROXY_PREVIEW=1 /usr/share/flowproxy/generate_nft.sh 2>/dev/null');
            if (!fd) return { config: '' };
            let content = fd.read('all');
            fd.close();
            return { config: safe_trim(content || '') };
        }
    },

    get_runtime_config: {
        call: function() {
            let res_file = '/tmp/flowproxy/runtime.tmp';
            let dns_file = '/tmp/flowproxy/dns_runtime.tmp';
            
            system('mkdir -p /tmp/flowproxy');
            system('/usr/share/flowproxy/generate_nft.sh runtime > ' + res_file + ' 2>&1');
            let nft_runtime = readfile(res_file) || "(failed)";
            system('rm -f ' + res_file);
            
            system('uci show dhcp.@dnsmasq[0] | grep -E "noresolv|dns_redirect|server" | sed -E "s/^dhcp\\.[^.]*\\.([^=]*)=(.*)/\\1: \\2/; s/\\x27//g; s/#/:/g" > ' + dns_file + ' 2>&1');
            let dns_out = readfile(dns_file);
            system('rm -f ' + dns_file);
            
            let dns_runtime = "\n--- [ DNSmasq Runtime Configuration ] ---\n";
            dns_runtime += (dns_out || "(no active dnsmasq overrides)");
            
            return { runtime: safe_trim(nft_runtime + dns_runtime) };
        }
    },

    get_interfaces: {
        call: function() {
            let interfaces = [];
            try {
                let ubus_conn = connect();
                if (ubus_conn) {
                    // 使用 network.device status 以获取所有物理设备 (包括 eth0 等 bridge 成员)
                    let dev_status = ubus_conn.call('network.device', 'status');
                    if (dev_status) {
                        for (let name in dev_status) {
                            push(interfaces, { name: name });
                        }
                    }
                    ubus_conn.disconnect();
                }
            } catch (e) {}
            return { interfaces };
        }
    },

    start_service: { call: function() { return { result: (system('/etc/init.d/flowproxy start >/dev/null 2>&1') === 0) }; } },
    stop_service: { call: function() { return { result: (system('/etc/init.d/flowproxy stop >/dev/null 2>&1') === 0) }; } },
    restart_service: { call: function() { return { result: (system('/etc/init.d/flowproxy restart >/dev/null 2>&1') === 0) }; } },
    clear_logs: { call: function() { try { writefile(LOG_FILE, ''); return { result: true }; } catch(e) { return { result: false }; } } }
};

return { 'luci.flowproxy': methods };
