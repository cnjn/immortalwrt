#!/bin/sh /etc/rc.common
START=99
STOP=9
USE_PROCD=1
start_service() {
    [ "$(uci -q get flowproxy.global.enabled)" = 1 ] || return 0
    local device node
    device=$(uci -q get flowproxy.global.device_fallback_enabled || echo 1)
    node=$(uci -q get flowproxy.global.node_fallback_enabled || echo 0)
    [ "$device$node" != 00 ] || return 0
    procd_open_instance health
    procd_set_param command /usr/share/flowproxy/guard.sh
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 12
    procd_close_instance
}
service_triggers() {
    procd_add_reload_trigger flowproxy
}
