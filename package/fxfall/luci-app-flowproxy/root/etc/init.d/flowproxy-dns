#!/bin/sh /etc/rc.common
# Managed by FlowProxy; no separate boot enablement is needed.
START=98
STOP=11
USE_PROCD=1
start_service() {
 [ -s /tmp/flowproxy/dns.conf ] || return 1
 /usr/sbin/flowproxy-dns /tmp/flowproxy/dns.conf --check || return 1
 rm -f /tmp/flowproxy/dns.ready
 procd_open_instance
 procd_set_param command /usr/sbin/flowproxy-dns /tmp/flowproxy/dns.conf
 procd_set_param respawn 3600 2 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param term_timeout 10
 procd_close_instance
}
stop_service() {
 rm -f /tmp/flowproxy/dns.ready
}
