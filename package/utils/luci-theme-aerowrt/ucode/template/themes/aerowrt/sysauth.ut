{% include('header', { blank_page: true }) %}

<section class="awrt-login-card" aria-labelledby="awrt-login-title">
	<div class="awrt-login-mark" aria-hidden="true">A</div>
	<h1 id="awrt-login-title">AeroWRT</h1>
	<p class="awrt-login-subtitle">{{ _('Sign in to manage your router') }}</p>
	<form method="post" class="cbi-map">
		<div class="cbi-section">
			<div class="cbi-section-node">
				<div class="cbi-value">
					<label class="cbi-value-title" for="luci_username">{{ _('Username') }}</label>
					<div class="cbi-value-field"><input name="luci_username" id="luci_username" type="text" autocomplete="username" value="{{ entityencode(duser, true) }}"></div>
				</div>
				<div class="cbi-value">
					<label class="cbi-value-title" for="luci_password">{{ _('Password') }}</label>
					<div class="cbi-value-field"><input name="luci_password" id="luci_password" type="password" autocomplete="current-password"></div>
				</div>
			</div>
		</div>
		{% if (fuser): %}<div class="awrt-alert awrt-alert-error">{{ _('Invalid username and/or password! Please try again.') }}</div>{% endif %}
		<button class="btn cbi-button cbi-button-positive" type="submit">{{ _('Log in') }}</button>
	</form>
</section>

{% include('footer', { blank_page: true }) %}
