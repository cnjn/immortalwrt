#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=99
USE_PROCD=1

start_service() {
	local auto_check

	config_load fwupdate
	config_get_bool auto_check main auto_check 1
	[ "$auto_check" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/fwupdate daemon
	procd_set_param respawn 3600 60 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger fwupdate
}
